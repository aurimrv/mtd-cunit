int new_job(int prio)
{
 int pid, status = 0;
 struct process *new_process;
 @
pid = next_pid++;@

 new_process = (struct process *)malloc(sizeof(struct process));
 if (!new_process)
  status = -3;
 else {
  new_process->pid = pid;
  new_process->priority = prio;
  new_process->next = (struct process *)0;
  status = enqueue(prio, new_process);
  if (status) {
   free(new_process);
  }
 }
 if (status)
  next_pid--;
 return (status);
}