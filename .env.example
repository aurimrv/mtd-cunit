# OpenRouter example — https://openrouter.ai/keys
# Copy to .env and set API_KEYS. .env is gitignored.

# Kill-attempt schedule (OpenRouter model ids). Length = attempt budget.
LLM_GEN_MODELS=openai/gpt-4o-mini,openai/gpt-4o-mini

# Length 1 ⇒ reused for every LLM_GEN_MODELS entry
API_KEYS=sk-or-v1-...
API_URLS=https://openrouter.ai/api/v1

LLM_EQUIV_MODEL=openai/gpt-4o-mini

# Other OpenRouter model id examples:
#   anthropic/claude-sonnet-4
#   google/gemini-2.5-flash
#   meta-llama/llama-3.3-70b-instruct
# Mixed providers via OpenRouter (one key, different model ids):
#   LLM_GEN_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4
