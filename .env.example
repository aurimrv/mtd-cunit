# Copy to .env and edit. .env is gitignored.

# Kill-attempt schedule: one LLM call per entry (order = attempt order).
# List length = number of attempts per mutant. Duplicates allowed.
LLM_GEN_MODELS=gpt-4o-mini,gpt-4o-mini

# Provider secrets / base URLs (OpenAI-compatible chat completions).
# Length 1 ⇒ reuse for every LLM_GEN_MODELS entry.
# Or same length as LLM_GEN_MODELS for per-attempt providers.
API_KEYS=sk-...
API_URLS=https://api.openai.com/v1

# Model for equivalence rationality after all kill attempts fail.
LLM_EQUIV_MODEL=gpt-4o-mini
