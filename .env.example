# Copy to .env and edit. .env is gitignored.
# Baseline tag without LLM kill loop: git tag no-llm-support

# Kill-attempt schedule: one LLM call per entry (order = attempt order).
# List length replaces max_iterations. Repeat a model to retry with the same id.
LLM_GEN_MODELS=composer-2,composer-2

# Provider endpoints / keys (comma-separated, parallel to LLM_GEN_MODELS).
# If a list has a single value, that value is used for every model entry.
# If lengths match LLM_GEN_MODELS, entry i uses API_KEYS[i] and API_URLS[i].
API_KEYS=sk-...
API_URLS=https://api.openai.com/v1

# Example with per-model providers (same number of commas as LLM_GEN_MODELS):
# LLM_GEN_MODELS=gpt-4o-mini,claude-sonnet,gpt-4o-mini
# API_KEYS=sk-openai-...,sk-anthropic-...,sk-openai-...
# API_URLS=https://api.openai.com/v1,https://api.anthropic.com,https://api.openai.com/v1

# Model used to write equivalence rationality after all kill attempts fail.
# Uses API_KEYS/API_URLS like a single-model call (first entry, or sole value).
LLM_EQUIV_MODEL=composer-2

# If 1, run one heuristic (mutation-oriented) probe before LLM_GEN_MODELS.
HEURISTIC_FIRST=0
